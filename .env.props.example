# Copy this file to .env.props (git-ignored) and adjust the path, or set the
# same variable in your shell:  export CHILLFOCUS_GAME_DIR="..."
#
# On Linux this is usually auto-detected, so you only need this file if the game
# lives in a non-default Steam library.
<Project>
  <PropertyGroup>
    <CHILLFOCUS_GAME_DIR>/home/USER/.local/share/Steam/steamapps/common/Chill with You Lo-Fi Story</CHILLFOCUS_GAME_DIR>
  </PropertyGroup>
</Project>
