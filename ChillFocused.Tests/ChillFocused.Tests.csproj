<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ChillFocused.Tests</AssemblyName>
    <RootNamespace>ChillFocused.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />

    <!--
      Pure layers are compiled automatically. Adding a new file under Domain,
      Sync, Status, Ports, Config, Support, UI/Model or Platform/Pure puts it in
      the test build without another csproj edit.

      Unity/BepInEx adapters are excluded by directory, so a stray UnityEngine
      using in a pure folder still fails this build.
    -->
    <Compile Include="../ChillFocused/Core/**/*.cs"
             Exclude="../ChillFocused/Core/UI/Unity/**/*.cs;../ChillFocused/Core/Runtime/**/*.cs;../ChillFocused/Core/Platform/Unity/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
